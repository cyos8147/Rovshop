datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Kept as plain strings (not native Postgres enums) so the app-level unions
// in src/lib/types.ts stay the single source of truth and new values (e.g.
// an extra rank tier) never need a migration — see that file for the
// allowed value unions (Role, AccountStatus, LoginType).

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model GameAccount {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  description        String
  price              Int
  discountPrice      Int?
  rank               String
  maxRank            String
  server             String         @default("TH")
  loginType          String         @default("FACEBOOK")
  heroCount          Int
  skinCount          Int
  rareSkins          String
  diamondBalance     Int            @default(0)
  coinBalance        Int            @default(0)
  status             String         @default("AVAILABLE")
  credentialUsername String?
  credentialPassword String?
  credentialNote     String?
  images             AccountImage[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
}

model AccountImage {
  id        String      @id @default(cuid())
  url       String
  position  Int         @default(0)
  account   GameAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

// Single-row site settings. Always read/written with id = "main".
model Settings {
  id         String   @id
  contactUrl String   @default("https://www.facebook.com/")
  updatedAt  DateTime @updatedAt
}
