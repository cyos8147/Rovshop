# Database (SQLite file for local dev — swap for PostgreSQL/MySQL connection string in production)
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed data creates this admin account (change the password after first login in production)
SEED_ADMIN_EMAIL="admin@rovshop.dev"
SEED_ADMIN_PASSWORD="Admin1234!"
