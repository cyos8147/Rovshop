# Database (PostgreSQL — e.g. Supabase). DATABASE_URL is the pooled
# "Transaction" connection string (Settings → Database → Connection string,
# "Transaction" mode, port 6543). DIRECT_URL is the direct/unpooled
# connection string (same page, port 5432) — Prisma Migrate needs it.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed data creates this admin account (change the password after first login in production)
SEED_ADMIN_EMAIL="admin@rovshop.dev"
SEED_ADMIN_PASSWORD="Admin1234!"

# Supabase Storage (stores uploaded product photos)
# Project URL and service_role key: Supabase dashboard → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is secret — never expose it to the browser or
# prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"
